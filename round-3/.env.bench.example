# One API key per lane, each minted in its OWN workspace/project — the
# provider's usage page then shows each lane's exact spend, independent of any
# self-reported number. Copy to .env.bench (gitignored) and fill in.
BENCH_KEY_EMPRYO=sk-ant-...
BENCH_KEY_PI=sk-ant-...
BENCH_KEY_OPENAI=sk-proj-...
# Optional: the $0.01 Haiku pre-pass helper ("marionette") on its own key.
BENCH_KEY_EMPRYO_MARIONETTE=sk-ant-...
